FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY pigeon-spring-boot-starter/pom.xml pigeon-spring-boot-starter/pom.xml
COPY pigeon-core/pom.xml pigeon-core/pom.xml
COPY pigeon-spring-boot-starter/src pigeon-spring-boot-starter/src
COPY pigeon-core/src pigeon-core/src
RUN mvn -q -B -pl pigeon-core -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/pigeon-core/target/*.jar /tmp/jars/
RUN set -e; f=$(ls /tmp/jars/*.jar | grep -v -- '-plain' | head -n1); cp "$f" /app/app.jar; rm -rf /tmp/jars
EXPOSE 8081
ENTRYPOINT ["java","-jar","/app/app.jar"]
