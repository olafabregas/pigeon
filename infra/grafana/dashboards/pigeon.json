{
  "uid": "pigeon-overview",
  "title": "Pigeon Overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["pigeon"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{uri}}",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Outbox dispatched (/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "description": "sent = confirmed; deferred = broker down (soft retry); failed/dead = permanent publish failures",
      "targets": [
        { "refId": "A", "legendFormat": "{{result}}",
          "expr": "sum by (result) (rate(pigeon_outbox_dispatched_total[1m]))" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Outbox pending",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "pending", "expr": "sum(pigeon_outbox_pending)" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Outbox lag (seconds)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "lag", "expr": "max(pigeon_outbox_lag_seconds)" }
      ]
    },
    {
      "id": 6, "type": "stat", "title": "Outbox dead count",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(pigeon_outbox_dead)" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Dispatch latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pigeon_outbox_dispatch_latency_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}}",
          "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "JVM threads",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}}", "expr": "jvm_threads_live_threads" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Process CPU usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}}", "expr": "process_cpu_usage" }
      ]
    }
  ]
}
